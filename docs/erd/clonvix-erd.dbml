
Project Clonvix {
  database_type: 'PostgreSQL'
  Note: 'Database schema for the Clonvix developer portfolio and GitHub explorer.'
}

Table user {
  id bigint [pk, increment]
  email varchar(254) [not null, unique]
  username varchar(150) [not null, unique]
  password varchar(128) [not null]
  first_name varchar(150)
  last_name varchar(150)
  is_active boolean [not null, default: true]
  is_staff boolean [not null, default: false]
  is_superuser boolean [not null, default: false]
  last_login timestamp
  date_joined timestamp [not null]
}

Table profile {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  display_name varchar(50)
  bio text
  image varchar(255)
  location varchar(100)
  website varchar(200)
  social_links jsonb
}

Table username_change_log {
  id bigint [pk, increment]
  user_id bigint [not null]
  old_username varchar(150) [not null, unique]
  changed_at timestamp [not null]
}

Table saved_repository {
  id bigint [pk, increment]
  user_id bigint [not null]
  github_id bigint [not null]
  owner varchar(39) [not null]
  name varchar(100) [not null]
  full_name varchar(141) [not null]
  description text
  html_url varchar(200) [not null]
  saved_at timestamp [not null]

  indexes {
    (user_id, github_id) [unique]
  }
}

Table clonvix_follow {
  id bigint [pk, increment]
  follower_id bigint [not null]
  following_id bigint [not null]
  created_at timestamp [not null]

  indexes {
    (follower_id, following_id) [unique]
  }

  checks {
    `follower_id <> following_id` [name: 'no_self_clonvix_follow']
  }
}

Table github_follow {
  id bigint [pk, increment]
  follower_id bigint [not null]
  github_username varchar(39) [not null]
  created_at timestamp [not null]

  indexes {
    (follower_id, `lower(github_username)`) [unique]
  }
}

Table repository_snapshot {
  id bigint [pk, increment]
  github_id bigint [not null]
  star_count integer [not null]
  snapshot_date date [not null]

  indexes {
    (github_id, snapshot_date) [unique]
  }
}

Ref: profile.user_id - user.id
Ref: username_change_log.user_id > user.id
Ref: saved_repository.user_id > user.id
Ref: clonvix_follow.follower_id > user.id
Ref: clonvix_follow.following_id > user.id
Ref: github_follow.follower_id > user.id
